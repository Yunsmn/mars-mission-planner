# --- HOUSTON: ground segment (cloud IBM Granite via watsonx.ai) ---
# Without these, HOUSTON falls back to local Granite (dev fallback) so the flow still runs offline.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_REGION=us-south

# --- MARVIN: onboard segment (local granite4.1:3b via Ollama) ---
# The flight build. Keep this the default everywhere except a latency-bound deploy.
ONBOARD_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434

# --- Deep-space link (compressed light-time, seconds each way) ---
LINK_DELAY_S=12

# --- NASA live feeds (garnish tier; optional, each feature-flagged) ---
NASA_API_KEY=
